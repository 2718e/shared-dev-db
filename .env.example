# Copy this file to .env for each independent Postgres instance.
# Keep .env private; the password below is only a local development example.
POSTGRES_USER=dev
POSTGRES_PASSWORD=change-this-before-use
POSTGRES_DB=postgres

# Host-side path to persistent database files. Use a different path for each
# instance, and use storage that persists for as long as the data is needed.
POSTGRES_DATA_DIR=./data

# The instance listens only on loopback by default.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# Optional local image tag; the image is built from Dockerfile.
# POSTGRES_IMAGE=shared-dev-db:18-postgis
